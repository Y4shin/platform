{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT g.id, g.template_id, g.recipient, g.venue, g.created,\n                   t.name AS template_name, t.body AS template_body\n            FROM greetings.greeting g\n            JOIN hello.greeting_template t ON t.id = g.template_id\n            ORDER BY g.created\n            ",
