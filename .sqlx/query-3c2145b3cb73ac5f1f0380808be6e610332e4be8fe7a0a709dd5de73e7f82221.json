  "query": "\n            SELECT e.id, e.title, e.description, e.location, e.starts_at, e.ends_at,\n                   e.all_day, e.updated_at\n            FROM events.event e\n            WHERE e.owner_kind = 'group' AND e.owning_group_id = $1\n            ORDER BY e.starts_at, e.id\n            ",
