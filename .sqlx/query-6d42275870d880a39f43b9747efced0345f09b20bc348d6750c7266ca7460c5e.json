{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT e.id, e.title, e.description, e.location, e.starts_at, e.ends_at,\n                   e.all_day, e.updated_at\n            FROM events.event e\n            WHERE e.id = $1\n              AND (e.visibility = 'public'\n                   OR platform.user_can_access('events:event', e.id, $2, 'events:read'))\n            ",
