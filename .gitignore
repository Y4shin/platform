# Rust
/target
**/*.rs.bk

# Node
node_modules/
dist/
build/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
# Stray `docker compose logs > logs` dumps at the repo root.
/logs

# Env files
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Local junius cache (populated by the CLI from M01 onward)
.junius-cache/

# direnv local cache (nix flake materialisations)
.direnv/

# Lingui compile output. `pnpm exec lingui compile` (and the
# `@lingui/vite-plugin` during dev) writes one `<locale>.js` next to each
# `<locale>.po`; only the `.po` source is committed. Dev/CI regenerate the
# `.js` files on demand.
**/i18n/*.js

# E2E run state: per-invocation rendered host config + stack URLs + juniusd
# log. Regenerated on every `task test:e2e`. Playwright's trace/screenshot
# output also lands at the repo root.
e2e/.playwright-state/
/test-results/
/playwright-report/

# nix results
/result
/result*

# docker image staging (populated by tools/build-images.sh from `nix
# build` outputs; docker COPY doesn't follow nix store symlinks, hence
# the dereference step).
/docker/staging/