{
  "$schema": "https://biomejs.dev/schemas/2.4.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "biome.json",
      "package.json",
      "tsconfig.base.json",
      "platform/frontend/**",
      "packages/**",
      "plugins/*/frontend/**",
      "!**/node_modules",
      "!**/.pnpm",
      "!**/dist",
      "!**/target",
      "!**/*.css",
      "!platform/frontend/src/generated",
      "!packages/generated/src",
      "!plugins/*/frontend/src/generated"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "indentWidth": 2,
      "trailingCommas": "none"
    }
  }
}
